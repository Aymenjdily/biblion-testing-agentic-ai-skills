# Clerk — client-safe publishable key (browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk — server-only secret key, never expose to the client
CLERK_SECRET_KEY=

# Auth routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity — not secret, but must match the Studio's project/dataset
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-04

# Sanity — server-only read token, never expose to the client
SANITY_API_READ_TOKEN=

# PostHog — client-safe project token (browser). Ingestion and the session
# replay recorder script are proxied first-party through /ingest (next.config.ts).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
