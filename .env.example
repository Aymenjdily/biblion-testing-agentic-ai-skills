# Site — canonical production URL, used for metadataBase, the OG image,
# robots.txt, and sitemap.xml. Swap for the real domain before deploying —
# defaults to a clearly-fake placeholder (see lib/site-config.ts).
NEXT_PUBLIC_SITE_URL=https://biblion.example.com

# Clerk — client-safe publishable key (browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk — server-only secret key, never expose to the client
CLERK_SECRET_KEY=

# Auth routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity — not secret, but must match the Studio's project/dataset
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-04

# Sanity — server-only read token, never expose to the client
SANITY_API_READ_TOKEN=

# Sanity Context MCP — server-only, powers intelligent search
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-03-03/context/mcp/:projectId/:dataset/search

# Groq — server-only, powers the search agent. Free tier, no billing
# required: create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional — defaults to openai/gpt-oss-20b
GROQ_SEARCH_MODEL=
